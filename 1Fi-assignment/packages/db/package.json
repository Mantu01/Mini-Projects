{
  "name": "@1fi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./schema": {
      "import": "./dist/src/schema/index.js",
      "types": "./dist/src/schema/index.d.ts"
    },
    "./zod": {
      "import": "./dist/src/zod/index.js",
      "types": "./dist/src/zod/index.d.ts"
    },
    "./types": {
      "import": "./dist/src/types.js",
      "types": "./dist/src/types.d.ts"
    },
    "./repositories": {
      "import": "./dist/src/repositories/index.js",
      "types": "./dist/src/repositories/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@1fi/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
